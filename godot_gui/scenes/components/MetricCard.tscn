[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/components/MetricCard.gd" id="1_metric"]

[node name="MetricCard" type="PanelContainer"]
custom_minimum_size = Vector2(0, 92)
size_flags_horizontal = 3
script = ExtResource("1_metric")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 8

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_type_variation = &"ObserverMuted"
text = "METRIC"

[node name="Value" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_type_variation = &"ObserverValue"
theme_override_font_sizes/font_size = 18
text = "$0.00"

[node name="Delta" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_type_variation = &"ObserverMuted"
text = "+0.00"
